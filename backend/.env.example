# ─── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── IA: Google Gemini ─────────────────────────────────────
# Chave em: https://aistudio.google.com/app/apikey
# Há um nível gratuito com limites (ver docs/AI.md)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Claude Sonnet 5.5 (Anthropic, esforço médio) como reserva quando o Gemini cair ou acabar a cota grátis.
# Chave em https://platform.claude.com/settings/keys (pago por uso).
ANTHROPIC_API_KEY=

# Claude Code com o seu plano Pro/Max (sem chave de API), sempre no claude-sonnet-5-5 com esforço médio.
# Uso pessoal; conta no limite do plano.
# Instale: npm install -g @anthropic-ai/claude-code  → rode "claude" uma vez e entre com a conta.
CLAUDE_CODE=off
# Se o comando não estiver no PATH: CLAUDE_CODE_PATH=C:\caminho\para\claude.cmd

# Sugestões de imagens na tela "Trocar imagem": Bing (internet e painéis de mangá), AniList e Danbooru funcionam sem chave.
# Para incluir o Google Imagens, crie uma chave grátis em https://serper.dev (2.500 buscas).
SERPER_API_KEY=

# auto = Gemini → Claude (API, se tiver chave) → Claude Code (se ligado)
# gemini | claude | claude-code = usa só aquele
LLM_PROVIDER=auto

# ─── Instagram (Graph API) ─────────────────────────────────
# Versão da Graph API; o padrão fica em src/services/graphApi.ts. Só mude se a Meta desativar a padrão.
# GRAPH_API_VERSION=v23.0

# ─── Cloudinary (URL pública do vídeo para publicar) ───────
# Conta gratuita: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── YouTube (enviar Shorts) ───────────────────────────────
# Cliente OAuth "App da Web" no Google Cloud, com a YouTube Data API v3 e a YouTube Analytics API ativadas. Ver docs/YOUTUBE.md
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# Para onde o callback volta depois de conectar
FRONTEND_URL=http://localhost:5173

# ─── Instagram OAuth (OPCIONAL / experimental) ─────────────
# A conexão por token (recomendada) NÃO precisa destas variáveis.
# Ver docs/INSTAGRAM.md
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# ─── Futuro: edição automática (ainda não usado) ──────────
# WHISPER_DIR=./tools/whisper         # instalado via @remotion/install-whisper-cpp
# WHISPER_MODEL=small                 # tiny | base | small | medium
# ELEVENLABS_API_KEY=                 # opcional: gerar a voz pelo app
# IMAGE_GEN_PROVIDER=none             # none | gemini | flux | sd-local
# PEXELS_API_KEY=                     # opcional
