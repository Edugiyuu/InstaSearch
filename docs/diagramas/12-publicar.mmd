sequenceDiagram
    participant M as Publicar
    participant BE as Backend
    participant CL as Cloudinary
    participant IG as Instagram
    participant YT as YouTube

    M->>BE: gerar MP4
    M->>BE: Instagram
    BE->>CL: sobe o MP4
